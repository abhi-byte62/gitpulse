# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Optional: GitHub Personal Access Token (PAT)
# Unauthenticated requests to GitHub API have a limit of 60 req/hr.
# Adding a token increases this limit to 5,000 req/hr.
# A fine-grained PAT or classic token with "public_repo" or no scopes is sufficient for public data.
GITHUB_TOKEN=

# Cache configuration (in seconds, default: 300)
CACHE_TTL_SECONDS=300
